{
  "name": "Climb Log",
  "description": "Log sends and fails, track 5 project routes across 8 grade systems.",
  "version": "2.8",
  "author": "skyfi",
  "modificationTime": 1775564994,
  "type": "feature",
  "usage": "workout",
  "in": [
    { "name": "Heartrate", "source": "Activity/Move/-1/Heartrate/Current", "type": "subscribe" }
  ],
  "out": [
    { "name": "routeNum" },
    { "name": "grade" },
    { "name": "routeTime" },
    { "name": "totalRoutes", "log": true, "shownName": "Total Routes", "format": "Count_Fourdigits" },
    { "name": "sessionTime" },
    { "name": "lastGrade" },
    { "name": "lastDuration" },
    { "name": "routeHrAvg" },
    { "name": "totalSends" },
    { "name": "bestSend" },
    { "name": "lastResult" },
    { "name": "climbMode" },
    { "name": "projTries" },
    { "name": "projSends" },
    { "name": "projBest" },
    { "name": "modeSub" }
  ],
  "template": [
    { "name": "setup.html" },
    { "name": "ready.html" },
    { "name": "climb.html" },
    { "name": "break.html" }
  ],
  "variables": [
    {"shownName": "Active System", "path": "stats.system", "type": "string"},
    {"shownName": "French", "path": "stats.french", "type": "string"},
    {"shownName": "UIAA", "path": "stats.uiaa", "type": "string"},
    {"shownName": "YDS", "path": "stats.yds", "type": "string"},
    {"shownName": "British", "path": "stats.british", "type": "string"},
    {"shownName": "Ice (WI)", "path": "stats.ice", "type": "string"},
    {"shownName": "Mixed", "path": "stats.mixed", "type": "string"},
    {"shownName": "V-Scale", "path": "stats.vscale", "type": "string"},
    {"shownName": "Fontainebleau", "path": "stats.font", "type": "string"},
    {"shownName": "Total Routes", "path": "stats.totalRoutes", "type": "int"},
    {"shownName": "Total Sends", "path": "stats.totalSends", "type": "int"},
    {"shownName": "Send Rate [%]", "path": "stats.sendPct", "type": "int"},
    {"shownName": "Sessions", "path": "stats.sessions", "type": "int"}
  ],
  "settings": []
}
