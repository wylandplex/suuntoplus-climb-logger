{
  "name": "Climb Log",
  "description": "Log sends and fails, track 5 project routes across 8 grade systems.",
  "version": "2.8",
  "author": "skyfi",
  "modificationTime": 1775570718,
  "type": "feature",
  "usage": "workout",
  "in": [
    { "name": "Heartrate", "source": "Activity/Move/-1/Heartrate/Current", "type": "subscribe" },
    { "name": "lapHrAvg", "source": "Activity/Lap/-1/HeartRate/Avg", "type": "subscribe" },
    { "name": "lapHrMax", "source": "Activity/Lap/-1/HeartRate/Max", "type": "subscribe" }
  ],
  "out": [
    { "name": "routeNum" },
    { "name": "grade" },
    { "name": "routeTime" },
    { "name": "totalRoutes", "log": true, "shownName": "Total Routes", "format": "Count_Fourdigits" },
    { "name": "sessionTime" },
    { "name": "lastGrade" },
    { "name": "lastDuration" },
    { "name": "routeHrAvg" },
    { "name": "totalSends" },
    { "name": "bestSend" },
    { "name": "lastResult" },
    { "name": "climbMode" },
    { "name": "projTries" },
    { "name": "projSends" },
    { "name": "projBest" },
    { "name": "modeSub" },
    { "name": "routeMaxHr" },
    { "name": "routePk1" },
    { "name": "routePk3" }
  ],
  "template": [
    { "name": "setup.html" },
    { "name": "ready.html" },
    { "name": "climb.html" },
    { "name": "break.html" }
  ],
  "variables": [
    {"shownName": "Active System", "path": "stats.system", "type": "string"},
    {"shownName": "French", "path": "stats.french", "type": "string"},
    {"shownName": "UIAA", "path": "stats.uiaa", "type": "string"},
    {"shownName": "YDS", "path": "stats.yds", "type": "string"},
    {"shownName": "British", "path": "stats.british", "type": "string"},
    {"shownName": "Ice (WI)", "path": "stats.ice", "type": "string"},
    {"shownName": "Mixed", "path": "stats.mixed", "type": "string"},
    {"shownName": "V-Scale", "path": "stats.vscale", "type": "string"},
    {"shownName": "Fontainebleau", "path": "stats.font", "type": "string"},
    {"shownName": "Project 1", "path": "stats.ps1", "type": "string"},
    {"shownName": "Project 2", "path": "stats.ps2", "type": "string"},
    {"shownName": "Project 3", "path": "stats.ps3", "type": "string"},
    {"shownName": "Project 4", "path": "stats.ps4", "type": "string"},
    {"shownName": "Project 5", "path": "stats.ps5", "type": "string"},
    {"shownName": "Project 6", "path": "stats.ps6", "type": "string"},
    {"shownName": "Project 7", "path": "stats.ps7", "type": "string"},
    {"shownName": "Project 8", "path": "stats.ps8", "type": "string"},
    {"shownName": "Project 9", "path": "stats.ps9", "type": "string"},
    {"shownName": "Project 10", "path": "stats.ps10", "type": "string"},
    {"shownName": "Total Routes", "path": "stats.totalRoutes", "type": "int"},
    {"shownName": "Total Sends", "path": "stats.totalSends", "type": "int"},
    {"shownName": "Send Rate [%]", "path": "stats.sendPct", "type": "int"},
    {"shownName": "Sessions", "path": "stats.sessions", "type": "int"},
    {"shownName": "Avg HR [bpm]", "path": "stats.avgHr", "type": "int"},
    {"shownName": "Avg Max HR [bpm]", "path": "stats.avgMaxHr", "type": "int"},
    {"shownName": "Avg Peak 1min HR [bpm]", "path": "stats.avgPk1", "type": "int"},
    {"shownName": "Avg Peak 3min HR [bpm]", "path": "stats.avgPk3", "type": "int"}
  ],
  "settings": []
}
