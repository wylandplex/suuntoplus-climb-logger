{
  "name": "Climb Log",
  "description": "Log sends and fails, track 5 project routes across 8 grade systems.",
  "version": "2.5",
  "author": "skyfi",
  "modificationTime": 1775515508,
  "type": "feature",
  "usage": "workout",
  "in": [
    { "name": "Heartrate", "source": "Activity/Move/-1/Heartrate/Current", "type": "subscribe" }
  ],
  "out": [
    { "name": "routeNum" },
    { "name": "grade" },
    { "name": "routeTime" },
    { "name": "totalRoutes", "log": true, "shownName": "Total Routes", "format": "Count_Fourdigits" },
    { "name": "sessionTime" },
    { "name": "lastGrade" },
    { "name": "lastDuration" },
    { "name": "routeHrAvg" },
    { "name": "totalSends" },
    { "name": "bestSend" },
    { "name": "lastResult" },
    { "name": "climbMode" },
    { "name": "projTries" },
    { "name": "projSends" },
    { "name": "projBest" },
    { "name": "modeSub" }
  ],
  "template": [
    { "name": "setup.html" },
    { "name": "ready.html" },
    { "name": "climb.html" },
    { "name": "break.html" }
  ],
  "settings": [
