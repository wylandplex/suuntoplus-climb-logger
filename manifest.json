{
  "name": "Climb Log",
  "description": "Climb logger: 8 grade systems, 40 projects, HR/HRR, height tracking, multi-year grade ramp.",
  "version": "3.0",
  "author": "skyfi",
  "modificationTime": 1776895615,
  "type": "feature",
  "usage": "workout",
  "in": [
    {
      "name": "H",
      "source": "Activity/Move/-1/Heartrate/Current",
      "type": "subscribe"
    },
    {
      "name": "A",
      "source": "Activity/Lap/-2/HeartRate/Avg",
      "type": "subscribe"
    },
    {
      "name": "M",
      "source": "Activity/Lap/-2/HeartRate/Max",
      "type": "subscribe"
    },
    {
      "name": "D",
      "source": "Activity/Lap/-2/Duration/Current",
      "type": "subscribe"
    },
    {
      "name": "Asc",
      "source": "Fusion/Altitude/Ascent",
      "type": "subscribe"
    }
  ],
  "out": [
    {
      "name": "routeNum"
    },
    {
      "name": "grade"
    },
    {
      "name": "lastGrade"
    },
    {
      "name": "routePk1"
    },
    {
      "name": "routePk3"
    },
    {
      "name": "totalSends"
    },
    {
      "name": "bestSend"
    },
    {
      "name": "climbMode"
    },
    {
      "name": "modeSub"
    },
    {
      "name": "climbing",
      "log": true,
      "shownName": "Climbing/Breaks",
      "format": "Count_Fourdigits"
    },
    {
      "name": "routeHeight",
      "log": true,
      "shownName": "Route Height [m]",
      "format": "Count_Fourdigits"
    }
  ],
  "template": [
    {
      "name": "ready.html",
      "displays": [
        "l",
        "m",
        "n",
        "o",
        "q",
        "s"
      ]
    },
    {
      "name": "climb.html",
      "displays": [
