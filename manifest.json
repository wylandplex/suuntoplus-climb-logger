{
  "name": "Climb Log",
  "description": "Track your progress on rock & ice.",
  "version": "3.0",
  "author": "skyfi",
  "modificationTime": 1780930662,
  "type": "feature",
  "usage": "workout",
  "in": [
    {
      "name": "H",
      "source": "Activity/Move/-1/Heartrate/Current",
      "type": "subscribe"
    },
    {
      "name": "A",
      "source": "Activity/Lap/-2/HeartRate/Avg",
      "type": "subscribe"
    },
    {
      "name": "M",
      "source": "Activity/Lap/-2/HeartRate/Max",
      "type": "subscribe"
    },
    {
      "name": "D",
      "source": "Activity/Lap/-2/Duration/Current",
      "type": "subscribe"
    },
    {
      "name": "Asc",
      "source": "Fusion/Altitude/Ascent",
      "type": "subscribe"
    }
  ],
  "out": [
