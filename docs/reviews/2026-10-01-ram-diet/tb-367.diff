@@ -0,0 +1,221 @@
+'use strict';
+
+// Drive the real app and satellites, injecting faults before/after array growth and
+// partway through project/fold mutations. These are consistency tests, not a watch
+// heap simulation: they prove bounded recovery and that incomplete sessions cannot save.
+var assert = require('assert');
+var platform = require('../proofs/platform');
+var skel = require('./v3skel');
+var cases = 0;
+
+function setup(legacy) {
+  var C = skel();
+  C.g = 0; C.u = 1; C.s0 = [9, 4, 44, 3, 60, 18];
+  C.p0 = [5,0,0,0,0, 2,0,0,0,0, 30,0,0,0,0, 18,-1,-1,-1,-1,''];
+  var seed = legacy ? { climbProjStats: {}, stats: { system: 'French', totalRoutes: 9, totalSends: 4, sessions: 3 }, watchSetup: {}, climbRoutes: [] } : { climbProjStats: C };
+  var p = platform.createPlatform({ seed: seed });
+  var app = p.createApp();
+  app.load(); app.warm(); app.toReady();
+  if (!legacy) app.selectProject(1);
+  return { p: p, app: app, before: platform.snapshot(p.storage.store) };
+}
+
+function pending(app) {
+  app.start(); app.ticks(4, { H: 2, Asc: app.state().startAsc + 12 });
+  app.press(6);
+  assert(app.state().frDirty, 'route must be pending');
+}
+
+function failPush(app, name, times, after) {
+  var array = app.sandbox[name], push = array.push;
+  var fault = { calls: 0, failures: 0 };
+  array.push = function (v) {
+    fault.calls++;
+    if (fault.failures < times) {
+      fault.failures++;
+      if (after) push.call(this, v);
+      throw new Error('injected ' + name + ' allocation');
+    }
+    return push.call(this, v);
+  };
+  return fault;
+}
+
+function failWrite(array, index, after) {
+  var value = array[index], calls = 0;
+  Object.defineProperty(array, index, {
+    configurable: true,
+    enumerable: true,
+    get: function () { return value; },
+    set: function (next) {
+      if (++calls === 1) {
+        if (after) value = next;
+        throw new Error('injected scalar write ' + index);
+      }
+      value = next;
+    }
+  });
+}
+
+function aligned(app, count) {
+  var st = app.state();
+  assert.strictEqual(st.routesA.length, count, 'route A tail');
+  assert.strictEqual(st.routesB.length, count, 'route B tail');
+}
+
+function noSave(run) {
+  run.app.end();
+  assert.deepStrictEqual(run.p.storage.store, run.before, 'failed session changed canonical/legacy storage');
+  assert.strictEqual(run.p.storage.calls.filter(function (c) { return c.op === 'setObject'; }).length, 0, 'failed session attempted a write');
+  assert(run.app.summary().some(function (r) { return r.id === 'ns'; }), 'missing NOT SAVED');
+  var calls = run.p.storage.calls.length, summary = run.app.summary();
+  run.app.end(); run.app.pause();
+  assert.strictEqual(run.p.storage.calls.length, calls, 'post-END hook touched storage');
+  assert.deepStrictEqual(run.app.summary(), summary, 'post-END hook lost failure banner');
+}
+
+// Each transient append failure must recover to the exact fault-free stored result,
+// including duration, height, HR-derived recap and project counters, with no duplicate.
+['routesA', 'routesB'].forEach(function (name) {
+  [false, true].forEach(function (after) {
+    [0, 1].forEach(function (prior) {
+      var run = setup(), control = setup(), app = run.app;
+      if (prior) { app.climb({ seconds: 3 }); control.app.climb({ seconds: 3 }); }
+      pending(app); pending(control.app);
+      var P = app.state().projSlot;
+      var fault = failPush(app, name, 1, after);
+      app.evaluate();
+      aligned(app, prior);
+      assert.deepStrictEqual(app.state().projSlot, P, 'append failure changed project counters');
+      assert(app.state().frDirty, 'transient failure lost pending route');
+      app.evaluate(); control.app.evaluate();
+      aligned(app, prior + 1);
+      assert.strictEqual(app.state().frDirty, 0);
+      assert.strictEqual(fault.failures, 1);
+      app.end(); control.app.end();
+      assert.deepStrictEqual(run.p.storage.store, control.p.storage.store);
+      assert.deepStrictEqual(app.summary(), control.app.summary());
+      cases++;
+    });
+  });
+});
+
+// R7: the injected projSlot scalar-write cases were removed together with ext10's
+// try/catch. On the watch a number store to an existing index (<=19) of the dense
+// projSlot array does not allocate, so this fault exists only under an injected
+// setter. Faults that can occur (loadExt/parse throw, append failure) happen before
+// any slot field changes and stay covered by the cases above and below.
+
+// Permanent append faults stop after three attempts and never retry every tick.
+// Even when the only route was lost, END must report NOT SAVED. Re-enabling the
+// same module must reset the failure latch and allow the next healthy session.
+['routesA', 'routesB'].forEach(function (name) {
+  [0, 1].forEach(function (prior) {
+    var run = setup(), app = run.app;
+    if (prior) app.climb({ seconds: 3 });
+    pending(app);
+    var fault = failPush(app, name, Infinity, true);
+    app.ticks(30);
+    aligned(app, prior);
+    assert.strictEqual(fault.calls, 3, 'allocation retries were not capped');
+    assert.strictEqual(app.state().frDirty, 0, 'input remains blocked at cap');
+    noSave(run);
+    app.load(); app.warm(); app.toReady(); app.selectProject(1);
+    app.climb({ seconds: 4 }); app.end();
+    assert.strictEqual(run.p.storage.peek('climbProjStats').s0[0], 10, 'reused module did not recover');
+    assert(!app.summary().some(function (r) { return r.id === 'ns'; }));
+    cases++;
+  });
+});
+
+// After abandoning a free route, BREAK still lets the user leave, but neither
+// crown direction nor Save as Project may target the previous recorded route.
+// Cover empty/nonempty histories, both array failures, pause/continue, and both
+// button/lap navigation. A subsequent successful route must regain its controls.
+['routesA', 'routesB'].forEach(function (name) {
+  [0, 1].forEach(function (prior) {
+    [false, true].forEach(function (pause) {
+      [false, true].forEach(function (lap) {
+        var run = setup(), app = run.app;
+        app.setFreeGrade(18);
+        if (prior) app.climb({ seconds: 3, height: 7 });
+        app.setFreeGrade(22);
+        pending(app);
+        var fault = failPush(app, name, 3, true);
+        app.ticks(3);
+        aligned(app, prior);
+        assert.strictEqual(fault.calls, 3);
+        assert.strictEqual(app.state().frDirty, 0);
+        if (pause) { app.pause(); app.continue(); app.warm(); }
+        var dropped = app.state();
+        [1, 2, 4, 5].forEach(function (eid) {
+          app.press(eid);
+          assert.deepStrictEqual(app.state(), dropped,
+            'discarded route button ' + eid + ' changed the previous route or project state');
+        });
+        if (lap) {
+          app.lap();
+          assert.strictEqual(app.state().state, 1, 'lap must start the next route');
+        } else {
+          app.press(6);
+          assert.strictEqual(app.state().state, 0, 'button must leave BREAK');
+          app.start();
+        }
+        app.climb({ seconds: 4, height: 9 });
+        var saved = app.state();
+        var tail = saved.routesA.length - 1;
+        app.press(1);
+        var edited = app.state();
+        assert.strictEqual(Math.floor(edited.routesA[tail] / 1e6), 23,
+          'the next committed route must regain crown editing');
+        assert.deepStrictEqual(edited.routesA.slice(0, tail), saved.routesA.slice(0, tail),
+          'editing the new route changed older routes');
+        assert.deepStrictEqual(edited.routesB, saved.routesB);
+        app.press(4);
+        var project = app.state();
+        assert.strictEqual(project.state, 0, 'the next committed route must support Save as Project');
+        assert.strictEqual(project.projGradeIdx[1], 23);
+        assert.strictEqual(Math.floor(project.routesA[tail] / 1e4) % 10, 2);
+        assert.deepStrictEqual(project.routesA.slice(0, tail), saved.routesA.slice(0, tail));
+        noSave(run);  // successful later routes must not clear the failed-session guard
+        cases++;
+      });
+    });
+  });
+});
+
+// END has no later tick to retry. Cover first/second routes, both schemas,
+// before/after growth, and direct stop versus pause-then-stop.
+[false, true].forEach(function (legacy) {
+  ['routesA', 'routesB'].forEach(function (name) {
+    [false, true].forEach(function (after) {
+      [false, true].forEach(function (pause) {
+        [0, 1].forEach(function (prior) {
+          var run = setup(legacy), app = run.app;
+          if (prior) app.climb({ seconds: 3 });
+          pending(app);
+          var P = app.state().projSlot;
+          var fault = failPush(app, name, 1, after);
+          if (pause) app.pause();
+          noSave(run);
+          assert.strictEqual(fault.failures, 1, 'END fault did not fire');
+          assert.deepStrictEqual(app.state().projSlot, P);
+          cases++;
+        });
+      });
+    });
+  });
+});
+
+// A partial fold at PAUSE or END invalidates a v3 save just like migration.
+[false, true].forEach(function (pause) {
+  var run = setup(), app = run.app;
+  app.climb({ seconds: 3 }); app.pause(); app.continue();
+  app.climb({ seconds: 4, height: 10 });
+  failWrite(app.sandbox.acc, 3, true);
+  if (pause) app.pause();
+  noSave(run);
+  cases++;
+});
+
+console.log('commit-fault-injection: ' + cases + ' cases passed (array/project rollback, capped retry, END guard, module reuse)');
