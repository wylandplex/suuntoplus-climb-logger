+  '\n;this.__st=function(){return {s:state,A:routesA.slice(),e:editIdx}};' +
+  'this.__l=onLoad;this.__e=evaluate;this.__v=onEvent;this.__x=onExerciseStart;', sb, { filename: 'main.js' });
