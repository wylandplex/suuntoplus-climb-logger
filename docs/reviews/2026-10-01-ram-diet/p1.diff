+check(Math.floor(A1 / 1e5) % 10 === 1 && Math.floor(A1 / 1e4) % 10 === 0 && A1 % 1e4 === 8, 'route 1 is send=1 cm=0 h=8: ' + A1);
+ev(1, 45); s = sb.__st();                                                 // BREAK flick up -> wGrade(len-1)
